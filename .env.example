# Database
DATABASE_URL="postgresql://telecalling:telecalling@localhost:5435/telecalling_crm?schema=public"

# API Server
PORT=4000
NODE_ENV="development"

# Auth & Tokens
JWT_SECRET="super-secret-key-change-in-prod"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-prod"
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# S3 / MinIO (Call Recordings)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="recordings"
S3_FORCE_PATH_STYLE="true"

# Web / Mobile
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
EXPO_PUBLIC_API_URL="http://localhost:4000/api"
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# WhatsApp Business Cloud API & Webhooks
WHATSAPP_WEBHOOK_VERIFY_TOKEN="solar_crm_wa_verify_token"
WHATSAPP_API_TOKEN="EAA..."
WHATSAPP_PHONE_NUMBER_ID="100..."

# Safety & Compliance Flags (Enterprise Simulation Gate)
CFG_SIMULATION_MODE="true"
CFG_WHATSAPP_SANDBOX="true"
